import openai
import os

# Load your OpenAI API key from an environment variable or replace 'your-api-key' with the actual key
openai.api_key = os.getenv("OPENAI_API_KEY") or 'your-api-key'

def get_chatgpt_response(prompt):
    try:
        response = openai.Completion.create(
            engine="text-davinci-003",  # Specify the model engine
            prompt=prompt,
            max_tokens=150,  # Max length of response
            n=1,  # Generate a single response
            stop=None,  # Stop generating after these tokens
            temperature=0.7  # Controls creativity of the response
        )
        return response.choices[0].text.strip()
    except Exception as e:
        return f"Error: {e}"

if __name__ == "__main__":
    prompt = input("Enter a prompt for ChatGPT: ")
    response = get_chatgpt_response(prompt)
    print("ChatGPT response:")
    print(response)

